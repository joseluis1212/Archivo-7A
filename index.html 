<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EL SOL NOS MIENTE · Registro de Anomalías del Eclipse</title>

    <!-- Preconexiones para mejorar rendimiento -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Fuentes con display=swap para evitar bloqueo -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/anton@latest/400.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/ibm-plex-mono@latest/400.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/ibm-plex-mono@latest/500.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/ibm-plex-mono@latest/700.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/special-elite@latest/400.css" media="print" onload="this.media='all'">

    <!-- CSS principal (extraído del inline, ahora en archivo externo) -->
    <link rel="stylesheet" href="css/styles.css">

    <!-- Fallback para navegadores sin JS -->
    <noscript>
        <style>
            .js-only { display: none !important; }
            .no-js-msg { display: block !important; }
        </style>
    </noscript>
</head>
<body>

    <!-- Capas atmosféricas (fondo, estrellas, ruido, viñeta) -->
    <div id="starfield" aria-hidden="true"></div>
    <div class="scanlines" aria-hidden="true"></div>
    <div class="noise" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>

    <!-- ============ TICKER ============ -->
    <section class="ticker" aria-label="Advertencia de emergencia" role="alert">
        <div class="ticker-track" aria-hidden="true">
            <span>
                ⚠ ADVERTENCIA DE ANOMALÍA SOLAR · EL SOL NOS MIENTE · NO MIRAR DIRECTAMENTE ·
                ⚠ REGISTRO DE ECLIPSE · AVISO DE SEGURIDAD · SOMBRA ANÓMALA DETECTADA ·
                ⚠ SOL NOS MIENTE · NO MIRAR DIRECTAMENTE · ECLIPSE ANÓMALO ·
            </span>
            <span>
                ⚠ ADVERTENCIA DE ANOMALÍA SOLAR · EL SOL NOS MIENTE · NO MIRAR DIRECTAMENTE ·
                ⚠ REGISTRO DE ECLIPSE · AVISO DE SEGURIDAD · SOMBRA ANÓMALA DETECTADA ·
                ⚠ SOL NOS MIENTE · NO MIRAR DIRECTAMENTE · ECLIPSE ANÓMALO ·
            </span>
        </div>
    </section>

    <!-- ============ TOPBAR ============ -->
    <header class="topbar" role="banner">
        <div class="brand">
            ARCHIVO 7A <small>· expediente clasificado</small>
        </div>
        <div class="live" aria-live="polite">
            <span class="dot" aria-hidden="true"></span>
            <b>EN DIRECTO</b> · <span id="liveCounter">0</span> testigos
        </div>
    </header>

    <!-- ============ HERO ============ -->
    <main>
        <section class="hero" aria-labelledby="hero-title">
            <div class="hero-left">
                <div class="stamp">⚠ ANOMALÍA CLASE 7A</div>
                <h1 class="glitch" id="hero-title" data-text="EL SOL NOS MIENTE">EL SOL NOS MIENTE</h1>
                <p class="lead">
                    <strong>Registro colaborativo de anomalías</strong> durante el eclipse solar del
                    <time datetime="2026-08-12">12 de agosto de 2026</time>.
                    Testimonios, sombras y evidencias que <strong>el Ministerio niega</strong>.
                </p>
                <div class="warning-box" role="note">
                    <div class="warning-title">⚠ PRECAUCIÓN EXTREMA</div>
                    <p>
                        <em>NO MIRAR DIRECTAMENTE</em> al sol durante el eclipse.
                        Las sombras pueden mostrar <em>comportamiento anómalo</em>.
                        Reporta cualquier irregularidad.
                    </p>
                </div>
                <a href="#upload" class="btn-soul" role="button">📡 SUBIR EVIDENCIA</a>
            </div>

            <div class="hero-right">
                <!-- Ilustración del eclipse (solo CSS) -->
                <div class="eclipse" aria-hidden="true">
                    <div class="corona"></div>
                    <div class="sun-disc"></div>
                    <div class="ring"></div>
                    <div class="ring r2"></div>
                    <div class="orb"></div>
                </div>

                <!-- Estadísticas rápidas -->
                <div class="hero-stats" role="list">
                    <div class="hstat" role="listitem">
                        <b id="statTestimonios">0</b>
                        <span>Testimonios</span>
                    </div>
                    <div class="hstat" role="listitem">
                        <b id="statSombras">0</b>
                        <span>Sombras</span>
                    </div>
                    <div class="hstat zero" role="listitem">
                        <b id="statVerificadas">0</b>
                        <span>Verificadas</span>
                    </div>
                    <div class="hstat" role="listitem">
                        <b id="statAlertas">⚠</b>
                        <span>Alertas activas</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ============ SECCIÓN SUBIDA ============ -->
        <section id="upload" aria-labelledby="upload-title">
            <div class="section-head">
                <span class="num">📡 01</span>
                <h2 id="upload-title">Subir evidencia</h2>
                <div class="sub">Tu testimonio puede cambiar la narrativa oficial</div>
            </div>

            <div class="upload-grid">
                <!-- Dropzone -->
                <div class="dropzone" id="dropzone" role="button" tabindex="0" aria-label="Arrastra o haz clic para subir una imagen">
                    <div class="dz-inner">
                        <span class="dz-icon" aria-hidden="true">🕳️</span>
                        <p><b>Arrastra</b> tu evidencia o <b>haz clic</b></p>
                        <p class="hint">Formatos: JPG, PNG, WEBP · Máx. 5MB</p>
                    </div>
                    <img id="preview" src="" alt="Vista previa de la evidencia" style="display:none;">
                    <div class="dz-overlay" id="dzOverlay">✅ Archivo listo</div>
                    <input type="file" id="fileInput" accept="image/*" aria-label="Seleccionar archivo de evidencia">
                </div>

                <!-- Formulario de metadatos -->
                <form class="upload-form" id="uploadForm" novalidate>
                    <label for="testimonio">Testimonio <b>*</b></label>
                    <input type="text" id="testimonio" placeholder="Describe lo que viste..." required aria-required="true">

                    <label for="testigo">Nombre o código <b>*</b></label>
                    <input type="text" id="testigo" placeholder="Ej. Testigo 7A, Anónimo, etc." required aria-required="true">

                    <label for="tipo">Tipo de anomalía</label>
                    <input type="text" id="tipo" placeholder="Ej. sombra, destello, desaparición...">

                    <button type="submit" id="go" disabled>🚨 Enviar al archivo</button>

                    <div class="progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                        <i id="progressBar" style="width:0%;"></i>
                    </div>
                    <div id="progressLabel" aria-live="polite">Esperando evidencia...</div>

                    <div class="status" id="status" role="status">🟡 Esperando tu testimonio</div>
                    <div class="form-note">* Campos obligatorios. Tus datos serán anonimizados.</div>
                </form>
            </div>
        </section>

        <!-- ============ GALERÍA ============ -->
        <section id="gallery-section" aria-labelledby="gallery-title">
            <div class="section-head">
                <span class="num">🕯️ 02</span>
                <h2 id="gallery-title">Evidencias registradas</h2>
                <div class="sub">Cada imagen y testimonio es una pieza del rompecabezas</div>
            </div>

            <div class="filters" role="tablist" aria-label="Filtrar evidencias">
                <button role="tab" aria-selected="true" data-filter="all" class="active">Todas</button>
                <button role="tab" aria-selected="false" data-filter="sombra">Sombras</button>
                <button role="tab" aria-selected="false" data-filter="destello">Destellos</button>
                <button role="tab" aria-selected="false" data-filter="desaparicion">Desapariciones</button>
                <button role="tab" aria-selected="false" data-filter="otro">Otro</button>
                <button role="tab" aria-selected="false" data-filter="verificado" class="danger">✅ Verificadas</button>
                <span id="syncLabel">🔄 sincronizando...</span>
            </div>
            <div id="galleryCount" aria-live="polite">0 evidencias</div>

            <div class="gallery" id="gallery" role="list">
                <!-- Las tarjetas se generarán dinámicamente con JS -->
            </div>
        </section>
    </main>

    <!-- ============ FOOTER ============ -->
    <footer role="contentinfo">
        <div>
            <div class="f-brand">ARCHIVO 7A</div>
            <div>Expediente clasificado · <span class="blinkline">⚠ EL SOL NOS MIENTE</span></div>
        </div>
        <div>
            <div>© 2026 · Ministerio de la Verdad</div>
            <div class="coords">Coordenadas: 34.6037° S, 58.3816° O</div>
        </div>
        <div>
            <div>Versión <span id="version">0.7.0</span></div>
            <div>Última actualización: <time datetime="2026-08-13">13/08/2026</time></div>
        </div>
    </footer>

    <!-- ============ LIGHTBOX ============ -->
    <div id="lightbox" role="dialog" aria-modal="true" aria-label="Ampliación de evidencia">
        <div class="lb-box">
            <img id="lbImage" src="" alt="Ampliación de evidencia">
            <div class="lb-info">
                <div class="cap" id="lbCaption">Testimonio</div>
                <div class="meta" id="lbMeta">ID · Tipo</div>
            </div>
        </div>
        <button class="lb-close" id="lbClose" aria-label="Cerrar ampliación">✕ CERRAR</button>
    </div>

    <!-- ============ TOAST ============ -->
    <div id="toast" role="alert" aria-live="assertive">Mensaje</div>

    <!-- ============ SCRIPTS ============ -->
    <script src="js/app.js" defer></script>
</body>
</html>
