    <span>◉ NO APUNTE INSTRUMENTOS ÓPTICOS DIRECTAMENTE AL EVENTO</span>
  </div>
</div>

<!-- Topbar -->
<header class="topbar">
  <div class="brand">EL SOL NOS MIENTE<small>ARCHIVO · v.1.0</small></div>
  <div class="live"><span class="dot"></span>TRANSMISIÓN <b>ACTIVA</b></div>
</header>

<!-- Hero -->
<main>
  <section class="hero" id="inicio">
    <div class="hero-left">
      <div class="stamp">◉ EXPEDIENTE CLASIFICADO</div>
      <h1 class="glitch" data-text="EL SOL NOS MIENTE">EL SOL NOS MIENTE</h1>
      <p class="lead">Un registro colaborativo de <strong>anomalías ópticas, distorsiones temporales y fenómenos no catalogados</strong> durante el eclipse. Sube tu evidencia, valida la de otros testigos y contribuye al archivo colectivo.</p>

      <div class="warning-box">
        <div class="warning-title">⚠ ADVERTENCIA OPERATIVA</div>
        <p>Las autoridades oficiales <em>niegan sistemáticamente</em> la existencia de irregularidades durante el fenómeno. Todo material subido se almacena <em>localmente en tu dispositivo</em> mediante almacenamiento persistente. No confíes en los canales oficiales.</p>
      </div>

      <a href="#registro" class="btn-soul">SUBIR EVIDENCIA</a>
    </div>

    <div class="hero-right">
      <div class="eclipse" aria-label="Representación del eclipse">
        <div class="corona"></div>
        <div class="ring r2"></div>
        <div class="ring"></div>
        <div class="sun-disc"></div>
        <div class="orb"></div>
      </div>
      <div class="hero-stats">
        <div class="hstat zero"><b id="statCount">0</b><span>EVIDENCIAS</span></div>
        <div class="hstat"><b>19.43°N</b><span>LATITUD</span></div>
        <div class="hstat"><b>99.12°W</b><span>LONGITUD</span></div>
        <div class="hstat"><b>T+00:04:12</b><span>FASE</span></div>
      </div>
    </div>
  </section>

  <!-- SUBIDA -->
  <section id="registro">
    <div class="section-head">
      <div class="num">01</div>
      <h2>REGISTRO DE EVIDENCIA</h2>
      <div class="sub">Sube tu archivo y documenta el fenómeno observado. Todo se conserva en tu dispositivo.</div>
    </div>

    <div class="upload-grid">
      <label for="fileInput" class="dropzone" id="dropzone" tabindex="0" aria-label="Zona de carga de evidencia">
        <input type="file" id="fileInput" accept="image/*">
        <div class="dz-inner">
          <span class="dz-icon">◉</span>
          <p><b>Arrastra tu evidencia aquí</b><br>o haz clic para seleccionar</p>
          <p class="hint">Formatos: JPG, PNG, WEBP · Máx 8 MB</p>
        </div>
        <img id="preview" alt="Vista previa">
        <div class="dz-overlay" id="dzOverlay">◉ EVIDENCIA CARGADA</div>
      </label>

      <form class="upload-form" id="uploadForm" autocomplete="off">
        <div>
          <label>01 · TÍTULO DEL HALLAZGO <b>*</b></label>
          <input type="text" id="title" placeholder="Ej: Silueta no identificada en la corona" required>
        </div>
        <div>
          <label>02 · DESCRIPCIÓN DEL FENÓMENO</label>
          <input type="text" id="caption" placeholder="Describe lo que observaste con detalle">
        </div>
        <div>
          <label>03 · CLASIFICACIÓN</label>
          <select id="category">
            <option value="anomalía">ANOMALÍA ÓPTICA</option>
            <option value="entidad">ENTIDAD NO CATALOGADA</option>
            <option value="distorsión">DISTORSIÓN TEMPORAL</option>
            <option value="censura">EVIDENCIA DE CENSURA</option>
            <option value="sin filtrar">SIN FILTRAR</option>
          </select>
        </div>
        <div>
          <label>04 · UBICACIÓN DEL TESTIGO</label>
          <input type="text" id="location" placeholder="Ciudad, región o coordenadas">
        </div>
        <div class="progress"><i id="progressBar"></i></div>
        <div id="progressLabel">ESPERANDO ARCHIVO…</div>
        <button type="submit" id="go" disabled>◉ REGISTRAR EN EL ARCHIVO</button>
        <div class="status" id="status">Sistema inicializado. Esperando evidencia.</div>
        <div class="form-note">⚠ Al enviar aceptas que tu registro formará parte del archivo público descentralizado.</div>
      </form>
    </div>
  </section>

  <!-- GALERÍA -->
  <section id="archivo">
    <div class="section-head">
      <div class="num">02</div>
      <h2>ARCHIVO DE ANOMALÍAS</h2>
      <div class="sub">Registros clasificados. Haz clic en una imagen para ampliarla. Usa "SOY TESTIGO" para validar observaciones.</div>
    </div>

    <div class="filters">
      <button data-filter="all" class="active">TODOS</button>
      <button data-filter="anomalía">ANOMALÍAS</button>
      <button data-filter="entidad">ENTIDADES</button>
      <button data-filter="distorsión">DISTORSIONES</button>
      <button data-filter="censura">CENSURA</button>
      <button data-filter="sin filtrar" class="danger">SIN FILTRAR</button>
      <button id="clearAll" class="danger" title="Eliminar todos los registros locales">✕ PURGAR ARCHIVO</button>
      <div id="syncLabel">◉ SINCRONIZADO</div>
      <div id="galleryCount"></div>
    </div>

    <div class="gallery" id="gallery"></div>
  </section>
</main>

<!-- Footer -->
<footer>
  <div class="f-brand">EL SOL NOS MIENTE</div>
  <div class="blinkline">◉ EL ARCHIVO PERMANECE</div>
  <div class="coords">19.4326° N · 99.1332° W · ÚLTIMA SINCRONIZACIÓN <span id="lastSync">--:--:--</span></div>
</footer>

<!-- Lightbox -->
<div id="lightbox" role="dialog" aria-modal="true" aria-label="Vista ampliada">
  <div class="lb-box" onclick="event.stopPropagation()">
    <button class="lb-close" id="lbClose">✕ CERRAR</button>
    <img id="lbImg" alt="">
    <div class="lb-info">
      <div class="cap" id="lbCap"></div>
      <div class="meta" id="lbMeta"></div>
    </div>
  </div>
</div>

<!-- Toast -->
<div id="toast" role="status" aria-live="polite"></div>

<script src="app.js"></script>
</body>
</html>
